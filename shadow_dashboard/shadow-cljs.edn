{:nrepl
 {:port 8777}

 :dev-http
 {8280
  {:root "resources/public"
   :push-state/headers {"content-type" "text/html; charset=utf-8"
                        "Cross-Origin-Opener-Policy" "same-origin"
                        "Cross-Origin-Embedder-Policy" "credentialless" #_"require-corp"}}}

 :deps {:aliases [:cljs]}


 :builds
 {:repl ; <- just for getting a stable connection for repling, optional
  {:target :browser
   :output-dir "resources/public"
   :modules {:repl {:entries [dashboard.core]
                    :web-worker true}}}
  :sw
  {:target :browser
   :output-dir "resources/public"
   :modules {:sw {:entries [cljs-thread.sw]
                  :web-worker true}}}
  :core
  {:target     :browser
   :output-dir "resources/public" ; <- necessary because sw.js must be in root, but output-dir doesn't work per module
   :js-options {:resolve {"highlight.js" {:target :npm :require "highlight.js/lib/core"}
                          "lowlight" {:target :npm :require "lowlight/lib/core"}}}
   :modules
   {:shared {:entries []}
    :screen
    {:init-fn dashboard.screen/init!
     :depends-on #{:shared}}
    :core
    {:init-fn dashboard.core/init!
     :depends-on #{:shared}
     :web-worker true}}}
  ;; Kernel-split: separate cljs-thread runtime into its own module
  ;; Workers load kernel.js first (small), then shared.js + core.js
  :kernel-split
  {:target     :browser
   :output-dir "target/kernel-split"
   :js-options {:resolve {"highlight.js" {:target :npm :require "highlight.js/lib/core"}
                          "lowlight" {:target :npm :require "lowlight/lib/core"}}}
   :modules
   {:kernel {:entries [cljs-thread.core]}
    :shared {:entries []
             :depends-on #{:kernel}}
    :screen
    {:init-fn dashboard.screen/init!
     :depends-on #{:shared}}
    :core
    {:init-fn dashboard.core/init!
     :depends-on #{:shared}
     :web-worker true}}}
  ;; Standalone kernel: independent build, carries only its own cljs.core subset
  :kernel-standalone
  {:target     :browser
   :output-dir "target/kernel-standalone"
   :modules    {:kernel {:entries [cljs-thread.core]
                         :web-worker true}}}}}
