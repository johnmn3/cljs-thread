(ns cljs-thread.root
  (:require-macros [cljs-thread.core :refer [spawn]])
  (:require
   [cljs-thread.env :as e]
   [cljs-thread.state :as s]
   [cljs-thread.on-when :refer [on-when]]
   [cljs-thread.msg :as m]
   [cljs-thread.future :as f]
   [cljs-thread.injest :as i]
   [cljs-thread.eve :as eve]
   [cljs-thread.util :as u]))

(defn ^:export init-root! [& [config-map]]
  (println "DBG root: init-root! ENTER")
  (assert (e/in-root?))
  (when config-map
    (let [config-map (if (object? config-map)
                       (js->clj config-map :keywordize-keys true)
                       config-map)]
      (swap! s/conf merge config-map)))
  (let [config @s/conf
        future-ids (:future-ids config)
        injest-ids (:injest-ids config)
        all-pool-ids (into (set future-ids) injest-ids)
        all-pool-ids (conj all-pool-ids :future)]

    (println "DBG root: waiting for pool workers:" (vec all-pool-ids))

    (on-when #(let [peer-ids (set (keys @s/peers))]
                (every? peer-ids all-pool-ids))
      {:max-time 30000}
      (println "DBG root: pool workers ready, peers:" (vec (keys @s/peers)))

      (-> (eve/eve-ready)
          (.then (fn [_]
                   (println "DBG root: eve-ready, spawning :core :db")
                   (println "DBG root: calling start-futures")
                   (f/start-futures config)
                   (println "DBG root: calling start-injests")
                   (i/start-injests config)
                   (println "DBG root: before spawn :core")
                   (js/console.error "CERR root: CALLING do_spawn for :core, do_spawn=" (str (.-do_spawn js/cljs_thread.spawn)))
                   (try
                     (spawn {:id :core :no-globals? true})
                     (catch :default ex
                       (println "DBG root: EXCEPTION in spawn :core:" (str ex) (.-stack ex))))
                   (js/console.error "CERR root: AFTER spawn :core call")
                   (println "DBG root: after spawn :core, peers:" (vec (keys @s/peers)))
                   (spawn {:id :db :no-globals? true})
                   (println "DBG root: after spawn :db, peers:" (vec (keys @s/peers)))

                   (on-when #(and (get @s/peers :core) (get @s/peers :db))
                     {:max-time 10000}
                     (println "DBG root: :core+:db ready, has-main-fn?:" (:has-main-fn? config))
                     (m/pair-ids :core :db)
                     (when (:has-main-fn? config)
                       (m/post :screen {:dispatch :core-ready}))
                     (println "DBG root: done"))))
          (.catch (fn [e] (println "DBG root: EXCEPTION in eve-ready chain:" (str e))))))))
