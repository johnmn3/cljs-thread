(ns cljs-thread.dom.install
  "Worker-side installation of DOM proxies on globalThis.

   Replaces the worker's globalThis.document, globalThis.window,
   and globalThis.navigator with Proxy objects that transparently
   forward all operations to the screen thread.

   navigator, location, history, localStorage, sessionStorage are all
   accessed through the window proxy (per implementation plan).

   Call `install!` once during worker initialization. Screen thread
   auto-initializes the registry when `dom.registry` is loaded.

   Only runs on worker threads."
  (:require [cljs-thread.env :as e]
            [cljs-thread.dom.proxy :as proxy]
            [cljs-thread.dom.constructors :as ctors]))

(defonce ^:private installed? (atom false))

(defn install!
  "Install DOM proxy objects on the worker's globalThis.
   Idempotent — safe to call multiple times.
   No-op on the screen thread."
  []
  (when (and (not (e/in-screen?))
             (not @installed?))
    (reset! installed? true)

    ;; Install synthetic constructors first
    (ctors/install!)

    ;; Install proxy objects for well-known DOM globals
    (let [doc-proxy (proxy/document-proxy)
          win-proxy (proxy/window-proxy)]

      ;; Use Object.defineProperty with getters for properties that may be
      ;; read-only. Don't overwrite js/self (used by cljs-thread messaging).
      (js/Object.defineProperty js/globalThis "document"
        #js {:get (fn [] doc-proxy) :configurable true})
      (js/Object.defineProperty js/globalThis "window"
        #js {:get (fn [] win-proxy) :configurable true})

      ;; navigator, location, history — all forward through window proxy
      ;; (per implementation plan: navigator is accessed as window.navigator)
      (js/Object.defineProperty js/globalThis "navigator"
        #js {:get (fn [] (unchecked-get win-proxy "navigator")) :configurable true})
      (js/Object.defineProperty js/globalThis "location"
        #js {:get (fn [] (unchecked-get win-proxy "location")) :configurable true})
      (js/Object.defineProperty js/globalThis "history"
        #js {:get (fn [] (unchecked-get win-proxy "history")) :configurable true})
      (js/Object.defineProperty js/globalThis "localStorage"
        #js {:get (fn [] (unchecked-get win-proxy "localStorage")) :configurable true})
      (js/Object.defineProperty js/globalThis "sessionStorage"
        #js {:get (fn [] (unchecked-get win-proxy "sessionStorage")) :configurable true}))))

(defn installed?*
  "Check if DOM proxies have been installed. For testing."
  []
  @installed?)

;; Auto-install on workers at namespace load time.
;; Screen thread is a no-op (install! checks in-screen?).
(install!)
