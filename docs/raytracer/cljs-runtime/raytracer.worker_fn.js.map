(ns raytracer.worker-fn
  "Worker-side render function for the cljs-thread ray tracer.
   Each worker receives two atoms via future conveyer:
     scene-atom — shared read-only scene data + atomic counter
     tile-atom  — this worker's own pre-allocated tile pixel arrays (zero contention)"
  (:require
   [cljs-thread.eve.array :as arr]
   [raytracer.vec3 :as v]
   [raytracer.camera :as cam]
   [raytracer.render :as render]))

(defn- unpack-scene
  "Reconstruct scene arrays from the shared atom state map."
  [state]
  (let [num-spheres (get state :num-spheres)
        num-materials (get state :num-materials)
        spheres (let [out #js []]
                  (dotimes [i num-spheres]
                    (let [prefix (str "s" i "-")]
                      (.push out #js [(get state (keyword (str prefix "cx")))
                                      (get state (keyword (str prefix "cy")))
                                      (get state (keyword (str prefix "cz")))
                                      (get state (keyword (str prefix "r")))
                                      (get state (keyword (str prefix "m")))])))
                  out)
        materials (let [out #js []]
                    (dotimes [i num-materials]
                      (let [prefix (str "m" i "-")]
                        (.push out #js [(get state (keyword (str prefix "t")))
                                        (get state (keyword (str prefix "r")))
                                        (get state (keyword (str prefix "g")))
                                        (get state (keyword (str prefix "b")))
                                        (get state (keyword (str prefix "p")))])))
                    out)
        look-from (v/vec3 (get state :cam-from-x)
                          (get state :cam-from-y)
                          (get state :cam-from-z))
        look-at (v/vec3 (get state :cam-at-x)
                        (get state :cam-at-y)
                        (get state :cam-at-z))
        vup (v/vec3 (get state :cam-up-x)
                    (get state :cam-up-y)
                    (get state :cam-up-z))]
    {:spheres spheres
     :materials materials
     :camera-opts {:look-from look-from
                   :look-at look-at
                   :vup vup
                   :vfov (get state :cam-vfov)
                   :aspect-ratio (get state :cam-aspect)
                   :aperture (get state :cam-aperture)
                   :focus-dist (get state :cam-focus-dist)}}))

(defn ^:export render-tile-range!
  "Render tiles assigned to this worker.
   scene-atom — shared, read-only scene data + atomic counter.
   tile-atom  — this worker's own atom with pre-allocated tile arrays."
  [scene-atom tile-atom tile-w tile-h img-w img-h spp]
  (let [scene-state @scene-atom
        {:keys [spheres materials camera-opts]} (unpack-scene scene-state)
        camera (cam/make-camera camera-opts)
        counter (:counter scene-state)
        tile-state @tile-atom
        first-tile (:first-tile tile-state)
        last-tile (:last-tile tile-state)]
    (loop [tile-idx first-tile]
      (when (< tile-idx last-tile)
        (let [tile-arr (get tile-state (keyword (str "t" tile-idx)))
              pixel-buf (arr/get-typed-view tile-arr)]
          (render/render-tile! tile-idx tile-w tile-h img-w img-h spp
                               pixel-buf camera spheres materials)
          ;; Atomic increment on shared counter — the only cross-worker touch point
          (arr/add! counter 0 1)
          (recur (inc tile-idx)))))))

(defn ^:export render-tile
  "Render a single tile. Returns [tile-idx pixel-buf].
   For use with pmap — each call is independent."
  [scene-atom tile-idx tile-w tile-h img-w img-h spp]
  (let [scene-state @scene-atom
        {:keys [spheres materials camera-opts]} (unpack-scene scene-state)
        camera (cam/make-camera camera-opts)
        pixel-buf (js/Uint8ClampedArray. (* tile-w tile-h 4))]
    (render/render-tile! tile-idx tile-w tile-h img-w img-h spp
                         pixel-buf camera spheres materials)
    [tile-idx pixel-buf]))
