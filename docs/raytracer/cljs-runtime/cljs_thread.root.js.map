(ns cljs-thread.root
  (:require-macros [cljs-thread.core :refer [spawn]])
  (:require
   [cljs-thread.env :as e]
   [cljs-thread.state :as s]
   [cljs-thread.on-when :refer [on-when]]
   [cljs-thread.msg :as m]
   [cljs-thread.future :as f]
   [cljs-thread.injest :as i]
   [cljs-thread.eve :as eve]
   [cljs-thread.util :as u]))

(defn ^:export init-root! [& [config-map]]
  (u/boot-log "root" "init-root! ENTER")
  (assert (e/in-root?))
  (when config-map
    (let [config-map (if (object? config-map)
                       (js->clj config-map :keywordize-keys true)
                       config-map)]
      (swap! s/conf merge config-map)))
  (let [config @s/conf
        future-ids (:future-ids config)
        injest-ids (:injest-ids config)
        ;; All pool worker IDs that must be in peers before spawning :core
        all-pool-ids (into (set future-ids) injest-ids)
        ;; Also need :future coordinator
        all-pool-ids (conj all-pool-ids :future)]

    (u/boot-log "root" (str "waiting for pool workers: " (vec all-pool-ids)))

    ;; Wait for ALL pool workers to appear in peers
    (on-when #(let [peer-ids (set (keys @s/peers))]
                (every? peer-ids all-pool-ids))
      {:max-time 30000}
      (u/boot-log "root" "all pool workers in peers")

      ;; Now wait for eve-ready
      (-> (eve/eve-ready)
          (.then (fn [_]
                   (u/boot-log "root" "eve-ready resolved")

                   ;; Call start-futures/start-injests (no-ops now, but kept for compat)
                   (u/boot-log "root" "calling start-futures")
                   (f/start-futures config)
                   (u/boot-log "root" "calling start-injests")
                   (i/start-injests config)

                   ;; NOW spawn :core and :db
                   (u/boot-log "root" "spawning :core")
                   (spawn {:id :core :no-globals? true})
                   (u/boot-log "root" "spawning :db")
                   (spawn {:id :db :no-globals? true})

                   ;; Wait for :core and :db to appear, then pair and signal screen
                   (on-when #(and (get @s/peers :core) (get @s/peers :db))
                     {:max-time 10000}
                     (u/boot-log "root" "pairing :core <-> :db")
                     (m/pair-ids :core :db)

                     ;; Signal screen that :core is ready
                     (when (:has-main-fn? config)
                       (u/boot-log "root" "signaling :core-ready to screen")
                       (m/post :screen {:dispatch :core-ready}))

                     (u/boot-log "root" "init-root! complete"))))))))
